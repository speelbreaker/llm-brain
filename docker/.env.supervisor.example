# PR Supervisor Configuration
# Copy this file to .env.supervisor and fill in the values

# =============================================================================
# REQUIRED SETTINGS (when enabled)
# =============================================================================

# Enable the supervisor (default: 0)
SUPERVISOR_ENABLED=1

# GitHub webhook secret (create at repo Settings > Webhooks)
GITHUB_WEBHOOK_SECRET=

# GitHub token (fine-grained PAT with read/write PRs, comments)
GITHUB_TOKEN=

# =============================================================================
# AUTOFIX POLICY
# =============================================================================

# Enable Codex auto-fix (default: 0 - disabled)
SUPERVISOR_ENABLE_CODEX=0

# Autofix policy: label, telegram, or both (default: label)
# - label: PR must have the autofix label
# - telegram: User must approve via /autofix command
# - both: Requires both label AND telegram approval
SUPERVISOR_AUTOFIX_POLICY=label

# Label required for autofix (default: autofix-ok)
SUPERVISOR_AUTOFIX_LABEL=autofix-ok

# Require human review for high-risk changes (default: 1)
SUPERVISOR_REQUIRE_HUMAN_FOR_HIGH_RISK=1

# =============================================================================
# TELEGRAM NOTIFICATIONS
# =============================================================================

# Enable Telegram notifications (default: 0)
SUPERVISOR_TELEGRAM_ENABLED=0

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Default chat ID for notifications
TELEGRAM_CHAT_ID=

# Admin chat ID for alerts (optional)
TELEGRAM_ADMIN_CHAT_ID=

# Comma-separated list of allowed user IDs for commands
# Leave empty to allow all users (not recommended)
TELEGRAM_ALLOWED_USER_IDS=

# =============================================================================
# LIMITS AND THRESHOLDS
# =============================================================================

# Max fix attempts per job (default: 3)
SUPERVISOR_MAX_LOOPS=3

# Max files changed in a fix (default: 10)
SUPERVISOR_MAX_FILES_CHANGED=10

# Max lines of code changed in a fix (default: 300)
SUPERVISOR_MAX_LOC_CHANGED=300

# Allow PRs from forks (default: 0)
SUPERVISOR_ALLOW_FORKS=0

# Workspace TTL in hours (default: 24)
SUPERVISOR_WORKSPACE_TTL_HOURS=24

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# OpenAI API key (primary provider)
OPENAI_API_KEY=

# Gemini API key (fallback provider, optional)
GEMINI_API_KEY=

# Models for debate agents
MODEL_OPTIMIST=gpt-4o-mini
MODEL_SKEPTIC=gpt-4o
MODEL_ARBITER=gpt-4o-mini
CODEX_MODEL=gpt-4o

# =============================================================================
# VERIFICATION COMMANDS
# =============================================================================

# Commands to run for PR verification
CHECK_CMD_1=python -m pytest -q
CHECK_CMD_2=python -m ruff check .
# CHECK_CMD_3=

# Command timeout in seconds (default: 600)
SUPERVISOR_COMMAND_TIMEOUT=600

# =============================================================================
# DEBUG MODE
# =============================================================================

# Enable debug endpoints like /debug/simulate_pr_event (default: 0)
SUPERVISOR_DEBUG=0
