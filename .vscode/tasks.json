{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "App: Git Status",
      "type": "shell",
      "command": "git status",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Git Pull (rebase)",
      "type": "shell",
      "command": "git pull --rebase",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Git Push",
      "type": "shell",
      "command": "git push",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Smoke - Pytest (fast)",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Tests - Pytest (full suite)",
      "type": "shell",
      "command": "python -m pytest",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Lint - Ruff (check)",
      "type": "shell",
      "command": "python -m ruff check .",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Format - Ruff (format)",
      "type": "shell",
      "command": "python -m ruff format .",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Commit (prompt message)",
      "type": "shell",
      "command": "bash -lc 'read -p \"Commit message: \" msg; git add -A && git commit -m \"$msg\"'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "App: Auto - Commit+Push (smoke first)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "App: Smoke - Pytest (fast)",
        "App: Commit (prompt message)",
        "App: Git Push"
      ],
      "problemMatcher": []
    }
  ]
}
